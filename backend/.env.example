# Application
APP_ENV=development
APP_PORT=8080

# Database Configuration (PostgreSQL)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=knmp
DB_PASSWORD=secretpassword
DB_NAME=knmp_db
DB_SSLMODE=disable

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long

# Storage Configuration ('local' or 's3')
STORAGE_DISK=local
STORAGE_LOCAL_DIR=./storage/uploads

# S3 / MinIO (Optional)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=knmp-documents
S3_USE_SSL=false
