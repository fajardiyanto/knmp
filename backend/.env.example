# Application
APP_ENV=development
APP_PORT=8080

# Database Configuration (PostgreSQL)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=knmp
DB_PASSWORD=secretpassword
DB_NAME=knmp_db
DB_SSLMODE=disable

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long

# Storage Configuration ('local' or 's3')
STORAGE_DISK=local
STORAGE_LOCAL_DIR=./storage/uploads

# S3 / MinIO (Optional)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=knmp-documents
S3_USE_SSL=false

# AI Scan & Channel Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=

# Optional AI provider keys. If empty, AI Scan falls back to local rule-based analysis.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-3.7-flash
CLAUDE_MODEL=claude-sonnet-4-6
