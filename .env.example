# Root Environment Configuration for Docker Compose

# Database (PostgreSQL)
DB_CONNECTION=postgres
DB_HOST=db
DB_PORT=5432
DB_USER=knmp
DB_PASSWORD=secretpassword
DB_NAME=knmp_db
DB_SSLMODE=disable

# Backend (Golang Fiber)
APP_ENV=production
APP_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long
STORAGE_DISK=local
STORAGE_LOCAL_DIR=./storage/uploads

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword

# Frontend (React + Vite)
VITE_API_BASE_URL=http://localhost:8080
